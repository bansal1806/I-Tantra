<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            tools:text="Ready" />

        <!-- Only shown if SherpaEngine.init fails (e.g. low storage): a clear recovery
             path instead of the app just sitting stuck with disabled controls. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_retry"
            android:visibility="gone" />

        <!-- Language toggle: switches which model set SherpaEngine has loaded. Only one
             language's models are ever held in RAM at a time (see SherpaEngine.init). -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/langToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langHindiButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/lang_hindi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/langEnglishButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_english" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- M2 transport: one phone hosts (listens), the other joins by typing the host's
             local Wi-Fi IP. Both phones share a Wi-Fi network (hotspot from one of them, or
             a common router); no internet, just a local TCP socket (Transport.kt). -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_connection"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            tools:text="Not connected" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/roleToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hostButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_host" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/joinButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_join" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/joinRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hostIpLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_host_ip">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hostIpInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:text="@string/btn_connect" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- M3: alert side-channel. Tags the next sent message so the receiver plays it at
             max volume, through the ALARM audio path (sounds through silent/DND), and
             (already true of every message: no stop control exists) non-interruptibly. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/alertToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_send_as_alert" />

        <!-- Push-to-talk: STT direction. When connected, the recognized text is also sent
             to the peer, who speaks it: that's the walkie-talkie. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pttButton"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_hold_to_talk" />

        <TextView
            android:id="@+id/recognizedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_recognized_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recognizedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/placeholder_stt_idle" />

        <!-- M3: the whole point of iTantra, made visible. -->
        <TextView
            android:id="@+id/bitrateStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Sent 42 bytes — a voice note of the same length would be ~5.2 KB (124x smaller)"
            tools:visibility="visible" />

        <!-- M4: latency/RTF numbers, live off the real pipeline instead of a one-off
             benchmark: true every time you actually use the app, not just in a lab run. -->
        <TextView
            android:id="@+id/sttPerfStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="STT: 180ms decode (RTF 0.09) · sent 210ms after release"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/receivedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_received_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/receivedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/placeholder_stt_idle" />

        <TextView
            android:id="@+id/ttsPerfStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="TTS: 340ms synth (RTF 0.15) · spoken 360ms after arrival"
            tools:visibility="visible" />

        <!-- Text -> speech: TTS direction. Also what plays automatically when a frame
             arrives from the peer over the transport. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/speakInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/hint_speak_input">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/speakInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speakButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_gravity="end"
            android:text="@string/btn_speak" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
